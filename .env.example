# Generate a strong value for every deployed environment.
SECRET_KEY=

# Use production to require secure cookies and a configured SECRET_KEY.
GRIDVAULT_ENV=development

# Defaults to sqlite:///gridvault.db inside the ignored instance directory.
# DATABASE_URL=sqlite:///gridvault.db

# Optional comma-separated browser origins. Empty means same-origin only.
# SOCKETIO_CORS_ALLOWED_ORIGINS=https://gridvault.example.com

# Comma-separated existing callsigns allowed to bootstrap Access Control.
# GRIDVAULT_ADMIN_CALLSIGNS=YOUR_ADMIN_CALLSIGN

# Private chat attachments are stored outside the public static directory.
# CHAT_UPLOAD_FOLDER=C:\path\outside\the\web\root
# CHAT_UPLOAD_MAX_BYTES=26214400
